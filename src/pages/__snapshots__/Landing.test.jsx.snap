// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`página de inicio > renderiza igual que antes 1`] = `"<div class="min-h-screen bg-paper text-ink"><nav class="bg-white/95 backdrop-blur border-b border-line sticky top-0 z-50"><div class="max-w-6xl mx-auto px-4 sm:px-6"><div class="flex justify-between items-center h-16"><a class="flex items-center gap-2" aria-label="Banqueando, inicio" href="/"><img src="/logo.png" alt="" class="h-10 w-10 object-contain"><span class="text-xl font-bold bg-gradient-to-r from-cyan-600 to-purple-600 bg-clip-text text-transparent">Banqueando</span></a><div class="hidden md:flex items-center gap-8"><a class="text-muted hover:text-ink font-medium transition-colors" href="/quiz?tipo=tarjeta">Tarjetas</a><a class="text-muted hover:text-ink font-medium transition-colors" href="/quiz?tipo=credito">Créditos</a><a class="text-muted hover:text-ink font-medium transition-colors" href="/como-recomendamos">Cómo recomendamos</a><a class="bg-ink text-white px-5 py-2.5 rounded-full font-semibold hover:bg-black transition-colors" href="/quiz">Comparar</a></div><div class="md:hidden flex items-center gap-2"><a class="bg-ink text-white px-4 py-2 rounded-full font-semibold text-sm" href="/quiz">Comparar</a><button class="p-2 text-ink" aria-label="Abrir menú" aria-expanded="false"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg></button></div></div></div></nav><main><section class="bg-paper"><div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 md:py-16 grid md:grid-cols-[1.05fr_0.95fr] gap-10 md:gap-12 items-center"><div class="min-w-0"><p class="text-[13px] font-semibold uppercase tracking-[0.08em] text-accent mb-4">Comparador independiente · Colombia</p><h1 class="font-display font-extrabold text-[40px] sm:text-6xl leading-[1.02] tracking-[-0.035em] text-ink mb-5 [text-wrap:balance]">Tu próxima tarjeta o crédito, <span class="text-muted">con números reales.</span></h1><p class="text-lg text-muted max-w-[34ch] mb-7">Respondes unas preguntas y te mostramos las tres opciones que más te convienen, cuánto ganas o pagas al año y por qué.</p><div class="flex flex-wrap gap-3"><a class="bg-ink text-white px-6 py-3 rounded-full font-semibold hover:bg-black transition-colors" href="/quiz?tipo=tarjeta">Comparar tarjetas</a><a class="bg-white text-ink border border-line px-6 py-3 rounded-full font-semibold hover:border-ink transition-colors" href="/quiz?tipo=credito">Comparar créditos</a></div><ul class="flex flex-wrap gap-x-5 gap-y-1.5 mt-6 text-sm text-muted"><li class="flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-accent" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>Gratis</li><li class="flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-accent" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>No consulta centrales de riesgo</li><li class="flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-accent" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>Ninguna entidad paga por aparecer</li></ul></div><article class="bg-white border border-line rounded-3xl p-5 sm:p-6 shadow-[0_24px_60px_-32px_rgba(13,21,23,0.35)] min-w-0" aria-label="Ejemplo de resultado"><div class="flex justify-between items-start gap-3 mb-5"><span class="text-xs font-semibold uppercase tracking-wider bg-accent-soft text-accent px-2.5 py-1 rounded-full">Tu mejor opción</span><span class="text-xs text-muted text-right">Tarifas verificadas<br>16 de oct de 2026</span></div><div class="flex items-center gap-4 mb-5"><div class="relative w-24 shrink-0 aspect-[1.586] rounded-lg bg-gradient-to-br from-[#22313A] to-ink" aria-hidden="true"><span class="absolute left-3 top-5 w-4 h-3 rounded-sm bg-gradient-to-br from-[#E4C98A] to-[#B9975A]"></span><span class="absolute right-2 bottom-1.5 text-[10px] font-display font-extrabold italic text-white tracking-wide">VISA</span></div><div class="min-w-0"><p class="font-display font-bold text-lg leading-tight text-ink">LATAM Pass Visa Platinum</p><p class="text-sm text-muted">Banco de Bogotá</p></div></div><p class="font-display font-extrabold text-4xl sm:text-[44px] leading-none tracking-tight text-good">+$340.800</p><p class="text-sm text-muted mt-1.5 mb-4">te deja al año, ya descontada la cuota de manejo</p><ul class="border-t border-line pt-3 mb-4 grid gap-2 text-sm tabular-nums"><li class="flex justify-between gap-3"><span>21.600 millas LATAM Pass</span><span class="font-semibold text-good">+$820.800</span></li><li class="flex justify-between gap-3"><span>Cuota de manejo del año</span><span class="font-semibold text-bad">−$480.000</span></li><li class="flex justify-between gap-3"><span>Intereses (pagas el total)</span><span>$0</span></li></ul><div class="grid grid-cols-3 gap-2 mb-4"><div class="bg-paper rounded-xl px-3 py-2.5"><b class="block font-display font-bold text-ink">24,98%</b><span class="text-xs text-muted">Tasa EA</span></div><div class="bg-paper rounded-xl px-3 py-2.5"><b class="block font-display font-bold text-ink">$4M</b><span class="text-xs text-muted">Ingreso mínimo</span></div><div class="bg-paper rounded-xl px-3 py-2.5"><b class="block font-display font-bold text-ink">4</b><span class="text-xs text-muted">Salas VIP al año</span></div></div><p class="text-sm text-muted mb-4">Por qué está primero: quieres acumular millas y pagas el total cada mes.</p><p class="text-xs text-muted text-center">Ejemplo con un gasto de $1.500.000 al mes</p></article></div></section><section class="bg-white border-y border-line"><div class="max-w-6xl mx-auto px-4 sm:px-6 py-7 flex flex-wrap items-center gap-x-8 gap-y-3"><span class="text-sm text-muted shrink-0">Comparamos productos de</span><ul class="flex flex-wrap gap-x-6 gap-y-2 font-display font-bold text-[17px] tracking-tight text-[#39464B]"><li>Bancolombia</li><li>Davivienda</li><li>BBVA</li><li>Banco de Bogotá</li><li>DAVIbank</li><li>Nu</li><li>RappiCard</li><li>Banco Falabella</li><li>Nequi</li><li>Lineru</li></ul></div></section><section id="confianza" class="bg-night text-night-ink"><div class="max-w-6xl mx-auto px-4 sm:px-6 py-16 md:py-20"><h2 class="font-display font-extrabold text-3xl md:text-[44px] leading-[1.08] tracking-[-0.03em] max-w-[18ch] mb-4 [text-wrap:balance]">Te mostramos lo que el banco no pone en grande.</h2><p class="text-lg text-night-muted max-w-[52ch] mb-10">Revisamos las tarifas oficiales de cada producto y calculamos el costo real con tu forma de usarlo: cuota, intereses y lo que te devuelve.</p><div class="grid md:grid-cols-3 gap-8 md:gap-6"><div class="min-w-0"><p class="font-display font-extrabold text-[44px] leading-none tracking-[-0.03em] mb-3">12 / 12</p><h3 class="font-display font-bold text-lg mb-1.5">Tarjetas verificadas</h3><p class="text-night-muted max-w-[34ch]">Cada dato viene de la hoja de tarifas oficial del banco, con su fecha.</p></div><div class="min-w-0"><p class="font-display font-extrabold text-[44px] leading-none tracking-[-0.03em] mb-3">$0</p><h3 class="font-display font-bold text-lg mb-1.5">Pagos por aparecer</h3><p class="text-night-muted max-w-[34ch]">El orden depende solo de tus respuestas. Si algún día hay comisión, lo diremos.</p></div><div class="min-w-0"><p class="font-display font-extrabold text-[44px] leading-none tracking-[-0.03em] mb-3">0</p><h3 class="font-display font-bold text-lg mb-1.5">Consultas a centrales</h3><p class="text-night-muted max-w-[34ch]">Comparar no afecta tu historial. Solo usamos lo que tú respondes.</p></div></div><a class="inline-block mt-10 text-night-accent font-semibold hover:underline" href="/como-recomendamos">Cómo recomendamos →</a></div></section><section id="empezar" class="bg-paper"><div class="max-w-6xl mx-auto px-4 sm:px-6 py-14 md:py-20"><h2 class="font-display font-extrabold text-3xl md:text-4xl tracking-[-0.03em] text-ink mb-8">¿Qué quieres comparar?</h2><div class="grid md:grid-cols-2 gap-4"><a class="group bg-white border border-line hover:border-ink rounded-2xl p-6 md:p-7 flex flex-col gap-2.5 transition-colors min-w-0" href="/quiz?tipo=tarjeta"><h3 class="font-display font-bold text-2xl tracking-tight text-ink">Tarjetas de crédito</h3><p class="text-muted">Sin cuota, con millas o con cashback. Según cómo pagas y en qué gastas.</p><span class="mt-2 font-semibold text-accent">8 a 10 preguntas →</span></a><a class="group bg-white border border-line hover:border-ink rounded-2xl p-6 md:p-7 flex flex-col gap-2.5 transition-colors min-w-0" href="/quiz?tipo=credito"><h3 class="font-display font-bold text-2xl tracking-tight text-ink">Créditos</h3><p class="text-muted">Personales o para tu negocio, con la cuota estimada y si te cabe en el bolsillo.</p><span class="mt-2 font-semibold text-accent">9 a 11 preguntas →</span></a></div></div></section><section id="preguntas" class="bg-white border-t border-line"><div class="max-w-6xl mx-auto px-4 sm:px-6 py-14 md:py-20 grid md:grid-cols-[1fr_2fr] gap-8 md:gap-12"><h2 class="font-display font-extrabold text-3xl md:text-4xl tracking-[-0.03em] text-ink">Preguntas frecuentes</h2><div class="divide-y divide-line border-y border-line min-w-0"><details class="group py-5"><summary class="flex items-center justify-between cursor-pointer list-none"><h3 class="font-display font-bold text-lg text-ink pr-4">¿Realmente es gratis? ¿Cómo se sostienen?</h3><svg class="w-5 h-5 text-muted group-open:rotate-180 transition-transform flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg></summary><p class="mt-3 text-muted leading-relaxed max-w-[65ch]">Sí, es gratis para ti. Hoy ninguna entidad nos paga. Si en el futuro recibimos una comisión cuando alguien solicita un producto, lo diremos junto a ese producto, tú pagarás lo mismo que si fueras directo y no cambiará el orden de los resultados: el orden depende solo de tus respuestas.</p></details><details class="group py-5"><summary class="flex items-center justify-between cursor-pointer list-none"><h3 class="font-display font-bold text-lg text-ink pr-4">¿En qué se diferencian de otros comparadores?</h3><svg class="w-5 h-5 text-muted group-open:rotate-180 transition-transform flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg></summary><p class="mt-3 text-muted leading-relaxed max-w-[65ch]">Ellos te muestran una tabla con todos los productos para que TÚ compares manualmente. Nosotros hacemos un match 1-a-1 basado en TU perfil específico. No un ranking genérico de "los 10 mejores" que no consideran tu situación única.</p></details><details class="group py-5"><summary class="flex items-center justify-between cursor-pointer list-none"><h3 class="font-display font-bold text-lg text-ink pr-4">¿Mis datos están seguros? ¿Comparten mi información?</h3><svg class="w-5 h-5 text-muted group-open:rotate-180 transition-transform flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg></summary><p class="mt-3 text-muted leading-relaxed max-w-[65ch]">No vendemos ni compartimos tus datos personales con bancos ni terceros. Te pedimos WhatsApp y correo para mostrarte el resultado y contactarte sobre él; las ofertas solo te llegan si marcas la casilla opcional. Cuando das clic en «Solicitar», vas al sitio oficial de la entidad y no le enviamos tus datos. Puedes pedir que borremos tus datos cuando quieras.</p></details><details class="group py-5"><summary class="flex items-center justify-between cursor-pointer list-none"><h3 class="font-display font-bold text-lg text-ink pr-4">¿Ustedes aprueban la tarjeta o el crédito?</h3><svg class="w-5 h-5 text-muted group-open:rotate-180 transition-transform flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg></summary><p class="mt-3 text-muted leading-relaxed max-w-[65ch]">No. Somos un comparador, no un banco. Te recomendamos las mejores opciones para ti y te conectamos con la entidad. Ellos deciden si aprueban basados en su análisis de riesgo. Con tus respuestas te mostramos una probabilidad de aprobación estimada (alta, media o baja), pero no es una garantía.</p></details><details class="group py-5"><summary class="flex items-center justify-between cursor-pointer list-none"><h3 class="font-display font-bold text-lg text-ink pr-4">¿Qué pasa si ya tengo tarjeta?</h3><svg class="w-5 h-5 text-muted group-open:rotate-180 transition-transform flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg></summary><p class="mt-3 text-muted leading-relaxed max-w-[65ch]">¡Perfecto! Te mostramos opciones que pueden servirte más para tu perfil y, si nos dices cuánto pagas de cuota de manejo, cuánto ahorrarías. Puedes tener varias tarjetas (es normal y hasta recomendable) y usar cada una para lo que mejor optimiza.</p></details><details class="group py-5"><summary class="flex items-center justify-between cursor-pointer list-none"><h3 class="font-display font-bold text-lg text-ink pr-4">¿Cuánto tarda el proceso completo?</h3><svg class="w-5 h-5 text-muted group-open:rotate-180 transition-transform flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg></summary><p class="mt-3 text-muted leading-relaxed max-w-[65ch]">El quiz: 2-3 minutos. Aplicar a la entidad: 5-10 minutos. La aprobación y el desembolso dependen de cada entidad: algunas fintechs responden en minutos y otras tardan días.</p></details><details class="group py-5"><summary class="flex items-center justify-between cursor-pointer list-none"><h3 class="font-display font-bold text-lg text-ink pr-4">¿Qué tipos de crédito comparan?</h3><svg class="w-5 h-5 text-muted group-open:rotate-180 transition-transform flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg></summary><p class="mt-3 text-muted leading-relaxed max-w-[65ch]">Comparamos múltiples opciones: líneas de crédito, crédito de capital de trabajo, financiamiento de facturas, crédito para inventario, préstamos para expansión, y crédito de consumo. Dependiendo de tu perfil, te mostramos las opciones más compatibles.</p></details><details class="group py-5"><summary class="flex items-center justify-between cursor-pointer list-none"><h3 class="font-display font-bold text-lg text-ink pr-4">¿Necesito ser empresa formal o también aplica para informales?</h3><svg class="w-5 h-5 text-muted group-open:rotate-180 transition-transform flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg></summary><p class="mt-3 text-muted leading-relaxed max-w-[65ch]">Trabajamos con ambos. Tenemos opciones para empresas formalmente constituidas (SAS, Ltda, etc) y también para emprendedores e informales con ingresos demostrables. El quiz determina qué opciones aplican para tu caso específico.</p></details><details class="group py-5"><summary class="flex items-center justify-between cursor-pointer list-none"><h3 class="font-display font-bold text-lg text-ink pr-4">¿Qué información necesito para el quiz de crédito?</h3><svg class="w-5 h-5 text-muted group-open:rotate-180 transition-transform flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg></summary><p class="mt-3 text-muted leading-relaxed max-w-[65ch]">Para qué necesitas el dinero y cuánto, si es para ti o para tu negocio, tus ingresos o ventas aproximadas, tu historial crediticio y cuánto pagas hoy en deudas. No necesitas documentos: si decides solicitar, cada entidad te pedirá los suyos.</p></details></div></div></section></main><footer class="bg-white border-t border-line"><div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 grid gap-10 md:grid-cols-[2fr_1fr_1fr]"><div class="min-w-0"><a class="flex items-center gap-2" aria-label="Banqueando, inicio" href="/"><img src="/logo.png" alt="" class="h-10 w-10 object-contain"><span class="text-xl font-bold bg-gradient-to-r from-cyan-600 to-purple-600 bg-clip-text text-transparent">Banqueando</span></a><p class="text-muted mt-4 max-w-[46ch]">Compara tarjetas de crédito y créditos en Colombia según tu perfil. No somos un banco ni damos asesoría financiera: te ayudamos a comparar.</p></div><div><h3 class="font-display font-bold text-ink mb-3">Comparar</h3><ul class="space-y-2"><li><a class="text-muted hover:text-ink" href="/quiz?tipo=tarjeta">Tarjetas de crédito</a></li><li><a class="text-muted hover:text-ink" href="/quiz?tipo=credito">Créditos</a></li></ul></div><div><h3 class="font-display font-bold text-ink mb-3">Legal</h3><ul class="space-y-2"><li><a class="text-muted hover:text-ink" href="/como-recomendamos">Cómo recomendamos</a></li><li><a class="text-muted hover:text-ink" href="/terminos">Términos y condiciones</a></li><li><a class="text-muted hover:text-ink" href="/privacidad">Política de datos</a></li><li><a href="mailto:apelismercado@gmail.com" class="text-muted hover:text-ink">Contacto</a></li></ul></div></div><div class="border-t border-line"><div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 text-sm text-muted flex flex-wrap justify-between gap-2"><p>© 2026 Banqueando. Comparador independiente de tarjetas y créditos en Colombia.</p><p>Las condiciones finales las define cada entidad.</p></div></div></footer></div>"`;
