# Copiar a .env.local para desarrollo. En Vercel: Settings → Environment Variables.
# Supabase → Project Settings → API.
# Usar SOLO la clave pública (anon / publishable), nunca la service_role.
# Sin estas variables la app funciona, pero no guarda leads ni clics.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-publica
